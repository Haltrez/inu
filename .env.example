# --- Solana ---------------------------------------------------------------
# A paid RPC (Helius/QuickNode/Triton) is strongly recommended in production.
RPC_URL=https://api.mainnet-beta.solana.com

# The $REASON mint address (the pump.fun CA). Leave empty before launch:
# the site runs in preview mode with the holder gate disabled.
MINT=

# Secret key of the TREASURY wallet — the wallet that created the coin on
# pump.fun, so creator fees accrue to it. base58 string (Phantom export) or
# JSON byte array (solana-keygen). THIS KEY MOVES REAL MONEY — server only,
# never commit it, never reuse a personal wallet.
TREASURY_SECRET_KEY=

# --- AI judge -------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Round mechanics ------------------------------------------------------
ROUND_MINUTES=30
# Minimum whole tokens a wallet must hold to enter (0 = open to anyone).
MIN_HOLD=100000
# SOL kept back for rent + transaction fees, never paid out.
RESERVE_SOL=0.05
# Percent of the pot paid to each round's winner (rest rolls over).
PAYOUT_PCT=100
# Rounds with less than this many SOL in the pot roll over instead of paying.
MIN_POT_SOL=0.01
# Newest N entries sent to the judge each round.
MAX_ENTRIES_JUDGED=200

# --- Server ---------------------------------------------------------------
PORT=3000
DB_PATH=data/reason.db
